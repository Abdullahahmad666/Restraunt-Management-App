# Copy this file to backend/.env and adjust if you need to.
#   cp .env.example .env
#
# .env is gitignored. Never commit it, and never put a real production secret
# in either file.

DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True

# Generate your own:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-your-own

# 10.0.2.2 is how the Android emulator reaches your host machine.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
TIME_ZONE=Europe/London
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These are the defaults from docker-compose.yml at the repo root, so if you
# started the database with `docker compose up -d db` this line needs no edits
# and is the same for everyone on the team.
#
# Using a Postgres you installed yourself instead? Change the user, password
# and port to match, and create the database once:
#   createdb philly_compliance
DATABASE_URL=postgres://postgres:postgres@localhost:5432/philly_compliance

# Tests use this same connection. pytest-django creates and drops a separate
# test_philly_compliance database, so your development data is never touched.

# Comma-separated. Only consulted when CORS_ALLOW_ALL_ORIGINS is off.
CORS_ALLOWED_ORIGINS=http://localhost:8081

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
