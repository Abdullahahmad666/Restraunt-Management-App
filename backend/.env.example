# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=True
# Read by production settings only. Development accepts any host, because a
# phone on your LAN reaches the API by your machine's IP - which differs per
# person and changes with a new DHCP lease. See config/settings/development.py.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Karachi
LOG_LEVEL=DEBUG

# Postgres in every environment. sqlite:///db.sqlite3 works for a quick start.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurant

# Comma-separated. Only consulted when CORS_ALLOW_ALL_ORIGINS is off.
CORS_ALLOWED_ORIGINS=http://localhost:8081

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Outgoing email
# ---------------------------------------------------------------------------
# These are ONE account belonging to the app - the address registration OTPs
# and password-reset links are sent FROM. They are not per-user credentials;
# a user only ever appears as a recipient.
#
# Leave EMAIL_HOST blank and development.py falls back to the console backend,
# which prints the email (OTP included) into the runserver output instead of
# sending it. That is enough to click through the flows, but you cannot test
# actual delivery.
#
# To send for real, use a Gmail App Password - NOT the account password, which
# Google refuses for SMTP. Generate one at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
#
# DEFAULT_FROM_EMAIL must match EMAIL_HOST_USER, or one of its verified
# aliases. Gmail rewrites or rejects a From it did not authenticate.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
