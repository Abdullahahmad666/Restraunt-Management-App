# ---------------------------------------------------------- react native ---
# Regenerated by the Expo CLI on every `expo start` / `expo install`, and the
# CLI also strips it from tsconfig#include - so tracking it is pure churn. Our
# own ambient declarations live in mobile/src/types/env.d.ts instead.
expo-env.d.ts
.metro-health-check*
*.jsbundle

# Expo. .expo/ holds per-machine device history and dev-server state.
# android/ and ios/ are generated by `expo prebuild` from app.json - committing
# them lets the two disagree, and the folder wins.
.expo/
/mobile/android/
/mobile/ios/
*.hprof

# ------------------------------------------------------------------- ide ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.iml

