{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://invisiko-api.onrender.com/api/v1",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "15000"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://invisiko-api.onrender.com/api/v1",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "15000"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6810689054"
      }
    }
  }
}
