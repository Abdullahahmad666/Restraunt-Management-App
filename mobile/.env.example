# Copy to mobile/.env. Values are inlined at build time by
# react-native-dotenv and reach the app through src/config/env.ts.
# After changing this file: npm start -- --reset-cache
#
# Android emulator reaches the host at 10.0.2.2; iOS simulator uses localhost.
API_BASE_URL=http://10.0.2.2:8000/api/v1
API_TIMEOUT_MS=15000
