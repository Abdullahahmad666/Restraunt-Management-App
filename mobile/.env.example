# Copy to mobile/.env.
#
# Only EXPO_PUBLIC_* variables reach the app - Expo inlines them at build time,
# which also means they ship inside the bundle and are readable by anyone with
# the app. Never put a real secret here.
#
# After changing this file: npx expo start --clear
#
# Android emulator reaches the host at 10.0.2.2; iOS simulator uses localhost.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_TIMEOUT_MS=15000
