{
  "expo": {
    "name": "Invisiko",
    "slug": "phillyz",
    "owner": "invincibles",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "invisiko",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.invisiko.app",
      "supportsTablet": true,
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.invisiko.app",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#08172B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#08172B",
          "dark": {
            "backgroundColor": "#08172B"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock your saved sign-in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan the check-in QR code."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to confirm you're at the venue when you check in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Invisiko uses your photos so you can set a profile picture.",
          "cameraPermission": "Invisiko uses the camera so you can take a profile picture."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "e0ff8b7a-e714-4d41-a520-a69e184e70c4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e0ff8b7a-e714-4d41-a520-a69e184e70c4"
    },
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#08172B",
    "primaryColor": "#FE9A02"
  }
}
