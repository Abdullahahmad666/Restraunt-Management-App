{
  "expo": {
    "name": "Philly's Compliance",
    "slug": "phillyz",
    "owner": "invincibles",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "phillyscompliance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.phillys.compliance",
      "supportsTablet": true
    },
    "android": {
      "package": "com.phillys.compliance",
      "adaptiveIcon": {
        "backgroundColor": "#B23A18"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock your saved sign-in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan the check-in QR code."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to confirm you're at the venue when you check in."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e0ff8b7a-e714-4d41-a520-a69e184e70c4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e0ff8b7a-e714-4d41-a520-a69e184e70c4"
    }
  }
}
